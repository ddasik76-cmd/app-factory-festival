rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSchoolAccount() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@g\\.cnees\\.kr')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isApprovedMember() {
      return isSchoolAccount()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }
    function validProject() {
      return request.resource.data.keys().hasOnly([
        'title', 'description', 'category', 'tech', 'badges', 'actionText', 'actionIcon',
        'actionBgColor', 'authorName', 'authorRole', 'authorInitial', 'authorInitialBg',
        'imageUrl', 'rating', 'ratingCount', 'ratingTotal', 'plays', 'commentsCount', 'likes', 'url', 'simulatorType',
        'creatorId', 'createdBy', 'createdAt', 'hidden', 'hiddenAt', 'hiddenBy', 'aiTools', 'aiUsage', 'aiNote'
      ])
      && request.resource.data.createdBy == request.auth.uid
      && (isAdmin() || (isApprovedMember() && request.resource.data.creatorId == request.auth.uid))
      && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
      && request.resource.data.description is string && request.resource.data.description.size() <= 500
      && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80
      && request.resource.data.category in ['game', 'ai', 'study', 'fun']
      && request.resource.data.url is string && request.resource.data.url.matches('https?://[^\\s]+')
      && request.resource.data.imageUrl is string && request.resource.data.imageUrl.matches('https?://[^\\s]+')
      && request.resource.data.likes == 0
      && request.resource.data.plays is int && request.resource.data.plays == 0
      && request.resource.data.commentsCount == 0
      && request.resource.data.ratingCount is int && request.resource.data.ratingCount == 0
      && request.resource.data.ratingTotal is number && request.resource.data.ratingTotal == 0
      && request.resource.data.rating is number && request.resource.data.rating == 0
      && request.resource.data.hidden == false;
    }
    function validRatingSummaryChange(projectId) {
      let ratingPath = /databases/$(database)/documents/users/$(request.auth.uid)/ratings/$(projectId);
      let hadRating = exists(ratingPath);
      let oldValue = hadRating ? get(ratingPath).data.value : 0;
      let newValue = getAfter(ratingPath).data.value;
      let oldCount = resource.data.get('ratingCount', 0);
      let oldTotal = resource.data.get('ratingTotal', 0);
      let newCount = oldCount + (hadRating ? 0 : 1);
      let newTotal = oldTotal - oldValue + newValue;
      return signedIn()
        && existsAfter(ratingPath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount', 'ratingTotal'])
        && request.resource.data.ratingCount == newCount
        && request.resource.data.ratingTotal == newTotal
        && request.resource.data.rating == newTotal / newCount;
    }
    function validOwnCommentCountCreate(projectId) {
      let commentPath = /databases/$(database)/documents/projects/$(projectId)/comments/$(request.auth.uid);
      return signedIn()
        && !exists(commentPath)
        && existsAfter(commentPath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
        && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1;
    }
    function validOwnCommentCountDelete(projectId) {
      let commentPath = /databases/$(database)/documents/projects/$(projectId)/comments/$(request.auth.uid);
      return signedIn()
        && exists(commentPath)
        && !existsAfter(commentPath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
        && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1
        && request.resource.data.commentsCount >= 0;
    }
    match /projects/{projectId} {
      allow read: if resource.data.hidden == false || isAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow create: if validProject();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt', 'hiddenBy'])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          (request.resource.data.likes == resource.data.likes + 1
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(projectId))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(projectId)))
          ||
          (request.resource.data.likes == resource.data.likes - 1
            && request.resource.data.likes >= 0
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(projectId))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likes/$(projectId)))
        )
      );
      allow update: if resource.data.hidden == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
        && resource.data.get('plays', 0) is int
        && request.resource.data.plays is int
        && request.resource.data.plays == resource.data.get('plays', 0) + 1;
      allow update: if validRatingSummaryChange(projectId);
      allow update: if validOwnCommentCountCreate(projectId) || validOwnCommentCountDelete(projectId);

      match /comments/{commentId} {
        function projectBefore() { return get(/databases/$(database)/documents/projects/$(projectId)); }
        function projectAfter() { return getAfter(/databases/$(database)/documents/projects/$(projectId)); }
        function validCommentFields() {
          return request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoUrl', 'body', 'createdAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorPhotoUrl', 'body', 'createdAt', 'updatedAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 80
            && request.resource.data.authorPhotoUrl is string && request.resource.data.authorPhotoUrl.size() <= 2000
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500;
        }
        function pairedCommentCreate() {
          return exists(/databases/$(database)/documents/projects/$(projectId))
            && projectBefore().data.hidden == false
            && projectAfter().data.diff(projectBefore().data).affectedKeys().hasOnly(['commentsCount'])
            && projectAfter().data.commentsCount == projectBefore().data.get('commentsCount', 0) + 1;
        }
        function pairedCommentDelete() {
          return exists(/databases/$(database)/documents/projects/$(projectId))
            && projectAfter().data.diff(projectBefore().data).affectedKeys().hasOnly(['commentsCount'])
            && projectAfter().data.commentsCount == projectBefore().data.get('commentsCount', 0) - 1
            && projectAfter().data.commentsCount >= 0;
        }
        allow read: if true;
        allow create: if signedIn() && commentId == request.auth.uid
          && validCommentFields()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && pairedCommentCreate();
        allow update: if signedIn() && commentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
          && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin() || (signedIn() && commentId == request.auth.uid && pairedCommentDelete());
      }
    }
    match /users/{uid}/likes/{projectId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['projectId', 'createdAt'])
        && request.resource.data.projectId == projectId;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }
    match /users/{uid}/ratings/{projectId} {
      function projectBefore() { return get(/databases/$(database)/documents/projects/$(projectId)); }
      function projectAfter() { return getAfter(/databases/$(database)/documents/projects/$(projectId)); }
      function validRatingFields() {
        return request.resource.data.keys().hasOnly(['projectId', 'value', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['projectId', 'value', 'createdAt', 'updatedAt'])
          && request.resource.data.projectId == projectId
          && request.resource.data.value is int && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      }
      function pairedRatingChange() {
        let hadRating = exists(/databases/$(database)/documents/users/$(uid)/ratings/$(projectId));
        let oldValue = hadRating ? get(/databases/$(database)/documents/users/$(uid)/ratings/$(projectId)).data.value : 0;
        let oldCount = projectBefore().data.get('ratingCount', 0);
        let oldTotal = projectBefore().data.get('ratingTotal', 0);
        let newCount = oldCount + (hadRating ? 0 : 1);
        let newTotal = oldTotal - oldValue + request.resource.data.value;
        return exists(/databases/$(database)/documents/projects/$(projectId))
          && projectBefore().data.hidden == false
          && projectAfter().data.diff(projectBefore().data).affectedKeys().hasOnly(['rating', 'ratingCount', 'ratingTotal'])
          && projectAfter().data.ratingCount == newCount
          && projectAfter().data.ratingTotal == newTotal
          && projectAfter().data.rating == newTotal / newCount;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && validRatingFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && pairedRatingChange();
      allow update: if signedIn() && request.auth.uid == uid
        && validRatingFields()
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && pairedRatingChange();
      allow delete: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /memberRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isSchoolAccount() && signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (isSchoolAccount() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedAt', 'displayName', 'photoUrl', 'email'])
        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }
    match /members/{uid} {
      allow read: if resource.data.status == 'active' || isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    match /clubProfile/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /clubSchedules/{scheduleId} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
